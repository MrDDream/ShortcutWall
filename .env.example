# Copy to .env and adjust. Every variable is optional except the three
# security ones below, which must be changed before exposing the app.

# --- Security (change these!) -------------------------------------------------
SESSION_SECRET=change-me
ADMIN_USER=admin
ADMIN_PASS=admin123

# --- Server -------------------------------------------------------------------
PORT=3050
HOST=0.0.0.0
# Set to true behind a reverse proxy (Nginx, Traefik, Caddy…)
TRUST_PROXY=false
# fatal | error | warn | info | debug | trace (default: info in production)
LOG_LEVEL=
# Lets the app check and fetch logos of sites on your local network
# (192.168.x.x, 10.x.x.x, VPN…), the Docker host's own address included.
# Set to false on an instance open to people who shouldn't be able to probe
# your network. Loopback and cloud metadata addresses are always blocked.
ALLOW_PRIVATE_NETWORKS=true

# --- Branding and language ----------------------------------------------------
APP_NAME=ShortcutWall
# fr or en
APP_DEFAULT_LOCALE=en

# --- Help dialog (shown only if at least one is set) ---------------------------
SUPPORT_EMAIL=
SUPPORT_PHONE=

# --- Storage (defaults: ./data and ./public/uploads) ----------------------------
DATA_DIR=
UPLOAD_DIR=
