{
  "name": "shortcutwall",
  "version": "1.1.0",
  "description": "Self-hosted wall of website shortcuts with an admin area",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "shortcuts",
    "admin",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "dotenv": "^18.0.8",
    "ejs": "^7.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.2",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "session-file-store": "^1.5.0",
    "sharp": "^0.35.5",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "vitest": "^5.0.1"
  }
}
