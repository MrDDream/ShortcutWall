<%- include('partials/head', { pageTitle, bodyClass: 'page-admin' }) %>
<main class="page admin" id="main">
  <% if (typeof usesDefaultCredentials !== 'undefined' && usesDefaultCredentials) { %>
    <p class="callout callout--warning" role="alert">
      <%- include('partials/icon', { name: 'alert' }) %>
      <span><%= t('admin.defaultCredentialsWarning') %></span>
    </p>
  <% } %>

  <div class="admin-header">
    <div>
      <h2 class="admin-header__title"><%= t('app.adminTitle') %></h2>
      <p class="admin-header__subtitle"><%= t('admin.subtitle') %></p>
    </div>
    <div class="admin-header__actions">
      <a class="btn btn--secondary btn--lg" href="/admin/export" title="<%= t('admin.exportTitle') %>">
        <%- include('partials/icon', { name: 'download' }) %>
        <%= t('admin.export') %>
      </a>
      <button type="button" class="btn btn--secondary btn--lg" data-modal-open="modal-import">
        <%- include('partials/icon', { name: 'upload' }) %>
        <%= t('admin.import') %>
      </button>
      <button type="button" class="btn btn--primary btn--lg" data-modal-open="modal-site-new">
        <%- include('partials/icon', { name: 'plus' }) %>
        <%= t('admin.addSite') %>
      </button>
    </div>
  </div>

  <section class="card admin-card">
    <div class="admin-toolbar">
      <div class="admin-toolbar__title">
        <h2><%= t('admin.existingSites') %></h2>
        <span class="badge"><%= sites.length %></span>
      </div>
      <% if (sites.length) { %>
        <div class="search-field">
          <%- include('partials/icon', { name: 'search' }) %>
          <input
            type="search"
            class="input admin-search__input"
            data-admin-search="sites"
            placeholder="<%= t('search.placeholder') %>"
            aria-label="<%= t('search.label') %>"
            autocomplete="off"
          />
        </div>
      <% } %>
    </div>

    <% if (!sites.length) { %>
      <div class="empty-state small">
        <span class="empty-state__icon"><%- include('partials/icon', { name: 'inbox' }) %></span>
        <p class="empty-state__title"><%= t('admin.emptySites') %></p>
        <button type="button" class="btn btn--primary" data-modal-open="modal-site-new">
          <%- include('partials/icon', { name: 'plus' }) %>
          <%= t('admin.addSite') %>
        </button>
      </div>
    <% } %>

    <div class="admin-list" data-admin-list="sites" role="list">
      <% sites.forEach((site) => { %>
        <% const hasLogo = site.imageUrl && site.imageUrl.trim(); %>
        <div class="admin-item" role="listitem">
          <button
            type="button"
            class="admin-item__main"
            data-modal-open="modal-site-<%= site.id %>"
            title="<%= t('forms.edit') %>"
          >
            <span class="shortcut-thumb shortcut-thumb--sm <%= hasLogo ? '' : 'shortcut-thumb--fallback' %>" aria-hidden="true">
              <% if (hasLogo) { %>
                <img class="shortcut-thumb__image" src="<%= site.imageUrl %>" alt="" loading="lazy" />
              <% } %>
              <span class="shortcut-thumb__fallback"><%= site.name.charAt(0).toUpperCase() %></span>
            </span>
            <span class="admin-item__text">
              <span class="admin-item__title"><%= site.name %></span>
              <span class="admin-item__subtitle"><%= site.description || site.targetUrl %></span>
            </span>
          </button>
          <div class="admin-item__actions">
            <a
              class="icon-btn icon-btn--plain"
              href="<%= site.targetUrl %>"
              target="_blank"
              rel="noopener noreferrer"
              title="<%= t('shortcuts.siteAccessTitle') %>"
              aria-label="<%= t('shortcuts.siteAccessTitle') %> : <%= site.name %>"
            >
              <%- include('partials/icon', { name: 'arrowUpRight' }) %>
            </a>
            <button
              type="button"
              class="icon-btn icon-btn--plain"
              data-modal-open="modal-site-<%= site.id %>"
              title="<%= t('forms.edit') %>"
              aria-label="<%= t('forms.edit') %> : <%= site.name %>"
            >
              <%- include('partials/icon', { name: 'pencil' }) %>
            </button>
            <form method="post" action="/admin/site/<%= site.id %>/delete" class="delete-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button
                type="submit"
                class="icon-btn icon-btn--plain icon-btn--danger"
                title="<%= t('forms.delete') %>"
                aria-label="<%= t('forms.delete') %> : <%= site.name %>"
              >
                <%- include('partials/icon', { name: 'trash' }) %>
              </button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
  </section>

  <%- include('partials/site-modal', { site: null }) %>
  <%- include('partials/import-modal') %>
  <% sites.forEach((site) => { %>
    <%- include('partials/site-modal', { site }) %>
  <% }); %>

  <% if (typeof statusKey !== 'undefined' && statusKey) { %>
    <div class="toast-region">
      <p class="toast" role="status" data-toast>
        <%- include('partials/icon', { name: 'check' }) %>
        <span class="toast__message"><%= t(statusKey, typeof statusVars !== 'undefined' ? statusVars : {}) %></span>
        <% if (typeof undoToken !== 'undefined' && undoToken) { %>
          <button type="button" class="toast__action admin-banner__undo" data-undo-token="<%= undoToken %>"><%= t('admin.undo') %></button>
        <% } %>
        <button type="button" class="toast__close" data-toast-close aria-label="<%= t('help.close') %>">
          <%- include('partials/icon', { name: 'close' }) %>
        </button>
      </p>
    </div>
  <% } %>
</main>
<%- include('partials/footer') %>
