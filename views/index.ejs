<%- include('partials/head', { pageTitle, bodyClass: 'page-home', includeViewSwitch: true, viewMode }) %>
<main class="page" id="main">
  <section class="toolbar" aria-label="<%= t('search.label') %>">
    <div class="search-field">
      <label for="search-term" class="visually-hidden"><%= t('search.label') %></label>
      <%- include('partials/icon', { name: 'search' }) %>
      <input
        id="search-term"
        class="input"
        type="search"
        placeholder="<%= t('search.placeholder') %>"
        autocomplete="off"
      />
      <kbd class="search-field__kbd" aria-hidden="true">/</kbd>
    </div>
    <div class="toolbar__actions">
      <div class="select-field">
        <label for="sort-order" class="visually-hidden"><%= t('search.sortLabel') %></label>
        <%- include('partials/icon', { name: 'sort' }) %>
        <select id="sort-order" class="input search-bar__select">
          <option value="alpha"><%= t('search.sortAlphabetical') %></option>
          <option value="recent"><%= t('search.sortRecent') %></option>
        </select>
        <%- include('partials/icon', { name: 'chevronDown', className: 'icon--end' }) %>
      </div>
      <% if (supportEmail || supportPhone) { %>
        <button class="btn btn--secondary search-bar__help" type="button" data-help-trigger>
          <%- include('partials/icon', { name: 'help' }) %>
          <span class="hide-sm"><%= t('search.helpLink') %></span>
        </button>
      <% } %>
    </div>
  </section>

  <% if (supportEmail || supportPhone) { %>
    <div class="help-modal" id="help-modal" hidden>
      <div class="help-modal__backdrop" data-help-close></div>
      <div class="help-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="help-modal-title" tabindex="-1">
        <button class="icon-btn icon-btn--plain help-modal__close" type="button" data-help-close aria-label="<%= t('help.close') %>">
          <%- include('partials/icon', { name: 'close' }) %>
        </button>
        <span class="help-modal__badge"><%- include('partials/icon', { name: 'help' }) %></span>
        <p class="help-modal__title" id="help-modal-title">
          <span><%= t('help.titlePrefix') %></span>
          <span class="help-modal__url" data-help-url></span><span><%= t('help.titleSuffix') %></span>
        </p>
        <p class="help-modal__intro"><%= t('help.contactIntro') %></p>
        <ul class="help-modal__list">
          <% if (supportPhone) { %>
            <li>
              <a class="help-modal__contact" href="tel:<%= supportPhone %>">
                <span class="help-modal__icon"><%- include('partials/icon', { name: 'phone' }) %></span>
                <span class="help-modal__text">
                  <span class="help-modal__label"><%= t('help.phoneLabel') %></span>
                  <span class="help-modal__value"><%= supportPhone %></span>
                </span>
              </a>
            </li>
          <% } %>
          <% if (supportEmail) { %>
            <li>
              <a class="help-modal__contact" href="mailto:<%= supportEmail %>">
                <span class="help-modal__icon"><%- include('partials/icon', { name: 'mail' }) %></span>
                <span class="help-modal__text">
                  <span class="help-modal__label"><%= t('help.emailLabel') %></span>
                  <span class="help-modal__value"><%= supportEmail %></span>
                </span>
              </a>
            </li>
          <% } %>
        </ul>
      </div>
    </div>
  <% } %>

  <section
    class="shortcut-grid <%= viewMode === 'sites' ? 'is-active' : '' %>"
    id="sites-grid"
    data-category="sites"
    aria-label="<%= t('header.viewSites') %>"
  >
    <% if (!sites.length) { %>
      <div class="empty-state">
        <span class="empty-state__icon"><%- include('partials/icon', { name: 'globe' }) %></span>
        <p class="empty-state__title"><%= t('shortcuts.siteEmpty') %></p>
        <% if (isAuthenticated) { %>
          <p class="empty-state__text"><%= t('shortcuts.emptyHint') %></p>
          <a class="btn btn--primary" href="/admin?tab=sites">
            <%- include('partials/icon', { name: 'plus' }) %>
            <%= t('shortcuts.emptyCta') %>
          </a>
        <% } %>
      </div>
    <% } %>
    <% sites.forEach((shortcut) => { %>
      <% const sortName = shortcut.name || ''; %>
      <% const createdValue = shortcut.updatedAt || shortcut.createdAt || ''; %>
      <% const hasLogo = shortcut.imageUrl && shortcut.imageUrl.trim(); %>
      <%
        let host = '';
        try {
          host = new URL(shortcut.targetUrl).hostname.replace(/^www\./, '');
        } catch {
          host = '';
        }
      %>
      <article
        class="shortcut-card"
        data-name="<%= sortName.toLowerCase() %>"
        data-sort-name="<%= sortName %>"
        data-created="<%= createdValue %>"
        data-description="<%= `${shortcut.description || ''} ${host}`.toLowerCase() %>"
      >
        <div class="shortcut-thumb <%= hasLogo ? '' : 'shortcut-thumb--fallback' %>" aria-hidden="true">
          <% if (hasLogo) { %>
            <img class="shortcut-thumb__image" src="<%= shortcut.imageUrl %>" alt="" loading="lazy" />
          <% } %>
          <span class="shortcut-thumb__fallback"><%= shortcut.name.charAt(0).toUpperCase() %></span>
        </div>
        <h2 class="shortcut-title">
          <a
            class="shortcut-card__link"
            href="<%= shortcut.targetUrl %>"
            target="_blank"
            rel="noopener noreferrer"
            title="<%= t('shortcuts.siteAccessTitle') %> : <%= shortcut.name %>"
          ><%= shortcut.name %></a>
        </h2>
        <% if (shortcut.description) { %>
          <p class="shortcut-description" title="<%= shortcut.description %>"><%= shortcut.description %></p>
        <% } %>
        <% if (host) { %>
          <p class="shortcut-meta"><%= host %></p>
        <% } %>
        <div class="shortcut-actions">
          <a
            class="icon-button download"
            href="/site/<%= shortcut.id %>/download"
            title="<%= t('shortcuts.siteDownloadTitle') %>"
            aria-label="<%= t('shortcuts.siteDownloadTitle') %> : <%= shortcut.name %>"
          >
            <%- include('partials/icon', { name: 'download' }) %>
          </a>
        </div>
      </article>
    <% }); %>
  </section>

  <section
    class="shortcut-grid <%= viewMode === 'folders' ? 'is-active' : '' %>"
    id="folders-grid"
    data-category="folders"
    aria-label="<%= t('header.viewFolders') %>"
  >
    <% if (!folders.length) { %>
      <div class="empty-state">
        <span class="empty-state__icon"><%- include('partials/icon', { name: 'folder' }) %></span>
        <p class="empty-state__title"><%= t('shortcuts.folderEmpty') %></p>
        <% if (isAuthenticated) { %>
          <p class="empty-state__text"><%= t('shortcuts.emptyHint') %></p>
          <a class="btn btn--primary" href="/admin?tab=folders">
            <%- include('partials/icon', { name: 'plus' }) %>
            <%= t('shortcuts.emptyCta') %>
          </a>
        <% } %>
      </div>
    <% } %>
    <% folders.forEach((shortcut) => { %>
      <% const sortName = shortcut.name || ''; %>
      <% const createdValue = shortcut.updatedAt || shortcut.createdAt || ''; %>
      <article
        class="shortcut-card shortcut-card--folder"
        data-name="<%= sortName.toLowerCase() %>"
        data-sort-name="<%= sortName %>"
        data-created="<%= createdValue %>"
        data-description="<%= (shortcut.networkPath || '').toLowerCase() %>"
      >
        <div class="shortcut-thumb shortcut-thumb--folder" aria-hidden="true">
          <%- include('partials/icon', { name: 'folder' }) %>
        </div>
        <h2 class="shortcut-title">
          <a
            class="shortcut-card__link"
            href="/folder/<%= shortcut.id %>/download"
            title="<%= t('shortcuts.folderDownloadTitle') %>"
          ><%= shortcut.name %></a>
        </h2>
        <% if (shortcut.networkPath) { %>
          <p class="shortcut-meta shortcut-meta--mono" title="<%= shortcut.networkPath %>"><%= shortcut.networkPath %></p>
        <% } %>
        <span class="shortcut-corner" aria-hidden="true"><%- include('partials/icon', { name: 'download' }) %></span>
      </article>
    <% }); %>
  </section>
</main>
<%- include('partials/footer') %>
