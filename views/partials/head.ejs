<!DOCTYPE html>
<html lang="<%= locale %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <% const fullTitle = pageTitle ? `${pageTitle} - ${appName}` : appName; %>
    <title><%= fullTitle %></title>
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f6fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090f" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <script src="/theme.js"></script>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="<%= bodyClass || '' %>">
    <a class="skip-link" href="#main"><%= t('header.skipToContent') %></a>
    <header class="site-header">
      <div class="site-header__inner">
        <h1 class="brand">
          <a href="/">
            <img class="brand__logo" src="/images/logo.svg" alt="" width="34" height="34" />
            <span class="brand__name"><%= appName %></span>
          </a>
        </h1>
        <div class="header-actions">
          <button
            type="button"
            id="theme-toggle"
            class="icon-btn theme-toggle"
            aria-label="<%= t('header.themeToggle') %>"
            title="<%= t('header.themeToggle') %>"
          >
            <%- include('icon', { name: 'moon', className: 'icon-moon' }) %>
            <%- include('icon', { name: 'sun', className: 'icon-sun' }) %>
          </button>
          <% const currentLanguage = languages.find((language) => language.active) || languages[0]; %>
          <div class="dropdown" data-menu>
            <button
              type="button"
              class="btn btn--secondary language-menu__toggle"
              data-menu-toggle
              aria-haspopup="true"
              aria-expanded="false"
              aria-label="<%= t('header.language') %> : <%= currentLanguage.label %>"
              title="<%= t('header.language') %>"
            >
              <% if (currentLanguage.icon) { %>
                <img class="flag" src="<%= currentLanguage.icon %>" alt="" />
              <% } %>
              <span class="hide-sm"><%= currentLanguage.label %></span>
              <%- include('icon', { name: 'chevronDown', className: 'dropdown__chevron' }) %>
            </button>
            <div class="menu" data-menu-panel hidden>
              <% languages.forEach((language) => { %>
                <a
                  class="menu__item <%= language.active ? 'is-active' : '' %>"
                  href="/language/<%= language.code %>"
                  lang="<%= language.code %>"
                  hreflang="<%= language.code %>"
                  <% if (language.active) { %>aria-current="true"<% } %>
                >
                  <% if (language.icon) { %>
                    <img class="flag" src="<%= language.icon %>" alt="" />
                  <% } %>
                  <span class="menu__label"><%= language.label %></span>
                  <% if (language.active) { %>
                    <%- include('icon', { name: 'checkMark', className: 'menu__check' }) %>
                  <% } %>
                </a>
              <% }); %>
            </div>
          </div>
          <a
            class="icon-btn"
            href="<%= projectUrl %>"
            target="_blank"
            rel="noopener noreferrer"
            title="<%= t('header.github') %>"
            aria-label="<%= t('header.github') %>"
          >
            <%- include('icon', { name: 'github' }) %>
          </a>
          <% if (isAuthenticated) { %>
            <div class="header-admin-menu" data-menu>
              <a
                class="btn btn--secondary header-admin-menu__link"
                href="/admin"
                title="<%= t('header.adminLink') %>"
              >
                <%- include('icon', { name: 'shield' }) %>
                <span class="hide-sm"><%= t('header.adminLink') %></span>
              </a>
              <button
                type="button"
                class="icon-btn header-admin-menu__toggle"
                data-menu-toggle
                aria-haspopup="true"
                aria-expanded="false"
                aria-label="<%= t('header.logout') %>"
              >
                <%- include('icon', { name: 'chevronDown', className: 'dropdown__chevron' }) %>
              </button>
              <div class="menu header-admin-menu__dropdown" data-menu-panel hidden>
                <form action="/admin/logout" method="post">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="menu__item menu__item--danger header-admin-menu__logout">
                    <%- include('icon', { name: 'logout' }) %>
                    <%= t('header.logout') %>
                  </button>
                </form>
              </div>
            </div>
          <% } else { %>
            <a class="btn btn--secondary header-login" href="/admin" title="<%= t('header.login') %>">
              <%- include('icon', { name: 'user' }) %>
              <span class="hide-sm"><%= t('header.login') %></span>
            </a>
          <% } %>
        </div>
      </div>
    </header>
